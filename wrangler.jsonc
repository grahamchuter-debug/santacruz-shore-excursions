{
  // WORKERS STATIC ASSETS — Santa Cruz Shore Excursions (ADR-0001 / Palma V1.0 pattern)
  // Custom Domain routes intentionally omitted — user attaches apex/www separately.
  // After approval, add apex custom_domain for santacruzshoreexcursions.com only.
  // www → apex is handled by Cloudflare Redirect Rules (not a second Worker origin).
  "name": "santacruz-shore-excursions",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
